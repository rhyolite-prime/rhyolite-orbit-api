@model RhyoliteOrbit.Actors.MessageModels.StudentBillDto

@{
    Layout = null;
}

<!doctype html>
<html class="no-js" lang="zxx">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title>@Model.ReportHeader.SchoolName | Student Billing</title>
    <meta name="author" content="rhyoliteprime">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <link rel="apple-touch-icon" sizes="57x57" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/favicons/apple-icon-57x57.png">
    <link rel="apple-touch-icon" sizes="60x60" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/favicons/apple-icon-60x60.png">
    <link rel="apple-touch-icon" sizes="72x72" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/favicons/apple-icon-72x72.png">
    <link rel="apple-touch-icon" sizes="76x76" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-76x76.png">
    <link rel="apple-touch-icon" sizes="114x114" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-114x114.png">
    <link rel="apple-touch-icon" sizes="120x120" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-120x120.png">
    <link rel="apple-touch-icon" sizes="144x144" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-144x144.png">
    <link rel="apple-touch-icon" sizes="152x152" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-152x152.png">
    <link rel="apple-touch-icon" sizes="180x180" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/apple-icon-180x180.png">
    <link rel="icon" type="image/png" sizes="192x192" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/android-icon-192x192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="96x96" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/favicon-96x96.png">
    <link rel="icon" type="image/png" sizes="16x16" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/favicon-16x16.png">
    <link rel="manifest" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/manifest.json">
    <meta name="msapplication-TileColor" content="#ffffff">
    <meta name="msapplication-TileImage" content="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/img/favicons/ms-icon-144x144.png">
    <meta name="theme-color" content="#ffffff">
    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/css/app.min.css">
    <link rel="stylesheet" href="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/css/style.css">
    <style>
        du {
            text-decoration-line: underline;
            text-decoration-style: double;
        }
    </style>
</head>
<body>
    <div class="invoice-container-wrap">
        <div class="invoice-container">
            <main>
                <div class="as-invoice invoice_style9">
                    <div class="download-inner" id="download_section">
                        <header class="as-header header-layout7">
                            <div class="row align-items-center justify-content-between">
                                <div class="col-auto">
                                    @if (!string.IsNullOrEmpty(Model.ReportHeader.LogoUrl))
                                    {
                                        <div class="header-logo">
                                            <a href="#"><img src="@Model.ReportHeader.LogoUrl" alt="@Model.ReportHeader.SchoolName" width="80" height="80"></a>
                                        </div>
                                    }
                                </div>
                                <div class="col-auto">
                                    <h1 class="big-title">Student Bill</h1>
                                    <span><b>Bill No: </b># @Model.StudentBill.BillNo </span>
                                    <span><b>Date: </b> @Model.StudentBill.BillDate.ToString("dd-MMM-yyyy") </span>
                                </div>
                            </div>
                        </header>
                        <div class="row justify-content-between my-4">
                            <div class="col-auto">
                                <div class="invoice-left">
                                    @* Add informational notes here if required *@
                                </div>
                            </div>
                            <div class="col-auto">
                                <div class="invoice-right">
                                    <b>@Model.ReportHeader.SchoolName</b>
                                    <address>
                                        @Model.ReportHeader.SchAddress <br>
                                        @Model.ReportHeader.PrimaryPhoneNo <br>
                                        @Model.ReportHeader.Email
                                    </address>
                                </div>
                            </div>
                        </div>
                        <table class="invoice-table table-style3">
                            <tbody>
                                <tr>
                                    <th>Student ID:</th>
                                    <td>@Model.StudentInfo.StudentIdentifier</td>
                                    <th>Period:</th>
                                    <td>@Model.StudentBill.Period</td>
                                </tr>
                                <tr>
                                    <th>Student Name:</th>
                                    <td>@Model.StudentInfo.FullName</td>
                                    <th>Currency:</th>
                                    <td>@Model.StudentBill.CurrencyName</td>
                                </tr>
                                <tr>
                                    <th>Class:</th>
                                    <td>@Model.StudentInfo.ClassName</td>
                                    <th>Bill No:</th>
                                    <td>@Model.StudentBill.BillNo</td>
                                </tr>
                            </tbody>
                        </table>
                        <table class="invoice-table table-stripe3">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th style="text-align:right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var bill in Model.StudentBill.Details)
                                {
                                    <tr>
                                        <td>@bill.FeeName</td>
                                        <td style="text-align:right;">@Model.StudentBill.CurrencyCode @bill.FeeAmount.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="1"><b>Total Amount:</b></td>
                                    <td><strong>@Model.StudentBill.CurrencyCode @Model.StudentBill.BillAmount.ToString("N2")</strong></td>
                                </tr>
                            </tfoot>
                        </table>
                        <div class="row justify-content-between">
                            <div class="col-auto">
                                <table class="total-table2">
                                    <tr>
                                        <th>Balance BF :</th>
                                        <td>@Model.StudentBill.CurrencyCode @Model.StudentBill.BalanceBF.ToString("N2")</td>
                                    </tr>
                                    <tr>
                                        <th>Please Pay :</th>
                                        @{
                                            var amountToPay = Model.StudentBill.BalanceBF + Model.StudentBill.BillBalance;
                                        }
                                        <td>
                                            <strong>
                                                <du>@Model.StudentBill.CurrencyCode @amountToPay.ToString("N2")</du>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                        <div class="body-shape9"></div>
                        <div class="body-shape1"></div>
                    </div>
                </div>
            </main>
        </div>
    </div>
    <script src="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/js/vendor/jquery-3.6.0.min.js"></script>
    <script src="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/js/app.min.js"></script>
    <script src="https://res.cloudinary.com/rhyoliteprime/raw/upload/v1673229020/report-assistant/erp-assets/js/main.js"></script>
</body>
</html>